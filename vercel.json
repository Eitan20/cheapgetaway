{
  "framework": null,
  "cleanUrls": true,
  "images": {
    "sizes": [384, 640, 960],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      { "protocol": "https", "hostname": "static.cupid.travel" },
      { "protocol": "https", "hostname": "static.nuitee.cloud" }
    ]
  },
  "redirects": [
    {
      "source": "/travorium-landing",
      "destination": "/join-the-club",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/liteapi/:path*",
      "destination": "/api/liteapi?path=:path*"
    },
    {
      "source": "/expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/https://www.expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/https:/www.expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/http://www.expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/http:/www.expedia.com/:path*",
      "destination": "/import.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
