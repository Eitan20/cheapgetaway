{
  "framework": null,
  "cleanUrls": true,
  "images": {
    "sizes": [
      384,
      640,
      960
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "static.cupid.travel"
      },
      {
        "protocol": "https",
        "hostname": "static.nuitee.cloud"
      }
    ]
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "cheapgetaway.com"
        }
      ],
      "destination": "https://www.cheapgetaway.com/:path",
      "permanent": false
    },
    {
      "source": "/travorium-landing",
      "destination": "/join-the-club",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/liteapi/:path*",
      "destination": "/api/liteapi?path=:path*"
    },
    {
      "source": "/https\\://:wrapped(.*)",
      "destination": "/import.html"
    },
    {
      "source": "/https\\:/:wrapped(.*)",
      "destination": "/import.html"
    },
    {
      "source": "/http\\://:wrapped(.*)",
      "destination": "/import.html"
    },
    {
      "source": "/http\\:/:wrapped(.*)",
      "destination": "/import.html"
    },
    {
      "source": "/expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.expedia.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/hotels.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.hotels.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/booking.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.booking.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/kayak.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.kayak.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/priceline.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.priceline.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/agoda.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.agoda.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/tripadvisor.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.tripadvisor.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/orbitz.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.orbitz.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/travelocity.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.travelocity.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/google.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/www.google.com/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).expedia.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).hotels.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).booking.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).kayak.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).priceline.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).agoda.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).tripadvisor.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).orbitz.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).travelocity.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    },
    {
      "source": "/:sub([a-z0-9-]+).google.:tld([a-z.]+)/:path*",
      "destination": "/import.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
