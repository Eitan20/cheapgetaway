{
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/travorium-landing",
      "destination": "/join-the-club",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/liteapi/:path*",
      "destination": "/api/liteapi?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
